# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

SECRET_KEY=your-secret-key-here
DEBUG=True
DBT_KEY=
ESV_KEY=

# Database URLs — settings.py picks one per environment:
#   Vercel preview (staging backend) → DATABASE_STAGING_URL
#     (required there; the Aiven `stagingdb` database, never
#     `defaultdb`)
#   GCP + Vercel production          → DATABASE_URL
#   Local dev                        → DATABASE_LOCAL_URL, else
#     DATABASE_READ_URL (read-only user), else DATABASE_URL —
#     so reaching prod from a dev shell is a deliberate
#     opt-in, not the default.
# Discrete DB_* parts or local SQLite are the final fallback.
# See DEVELOPER_GUIDE "Environment Variables".
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_STAGING_URL=postgres://staging_rw:<pw>@<host>/stagingdb
# DATABASE_READ_URL=postgres://ai_agent:<pw>@<host>/defaultdb
# DATABASE_LOCAL_URL=sqlite:///db.sqlite3

# Remote Postgres TLS: GCP Secret `DB_SSL_CERT` content.
# Written to /tmp/ca.pem at startup (not repo ca.pem).
# DB_SSL_CERT=

# Google Cloud TTS + GCS audio (public config; auth is ADC on GCP)
GOOGLE_TTS_LANGUAGE_CODE=lv-LV
GOOGLE_TTS_VOICE_NAME=lv-LV-Chirp3-HD-Sadachbia
GOOGLE_TTS_SAMPLE_RATE_HERTZ=24000
AUDIO_BUCKET_NAME=bible-research-489314-bible-audio
AUDIO_SIGNED_URL_TTL_SECONDS=3600
MONTHLY_TTS_CHAR_LIMIT=100000
LOCK_STALE_HOURS=24

# Image attachments — GCS buckets (auth via ADC on GCP)
IMAGE_BUCKET_ORIGINALS=bible-research-489314-images-originals
IMAGE_BUCKET_THUMBNAILS=bible-research-489314-images-thumbnails
IMAGE_MAX_BYTES=10485760
IMAGE_SIGNED_URL_TTL_SECONDS=600
IMAGE_MAX_PER_NOTE=10
IMAGE_MAX_PER_COMMENT=5
